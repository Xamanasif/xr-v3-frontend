{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "envMode": "strict",
  "globalPassThroughEnv": ["CI"],
  "cacheDir": ".turbo/cache",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "src/generated/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:db": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": ["DATABASE_URL"]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false,
      "passThroughEnv": [
        "PLAYWRIGHT_BROWSERS_PATH",
        "XR_E2E_WEB_PORT",
        "XR_E2E_SPECIMENS_PORT",
        "XR_E2E_TEST_HOOKS_PORT"
      ]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "APP_ENV",
        "NODE_ENV",
        "LOG_LEVEL",
        "API_HOST",
        "API_PORT",
        "API_PUBLIC_URL",
        "CORS_ALLOWED_ORIGINS",
        "DATABASE_URL",
        "OIDC_ISSUER_URL",
        "OIDC_AUDIENCE",
        "OBJECT_STORAGE_ENDPOINT",
        "OBJECT_STORAGE_BUCKET",
        "OBJECT_STORAGE_ACCESS_KEY_ID",
        "OBJECT_STORAGE_SECRET_ACCESS_KEY"
      ]
    },
    "clean": {
      "cache": false
    }
  }
}
