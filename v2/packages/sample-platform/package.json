{
  "name": "@xr/sample-platform",
  "version": "0.0.0",
  "private": true,
  "description": "The mock adapter of the v46 frontend: one deterministic sample world per browser tab, the command pipeline and the Phase-0 service methods behind the @xr/contracts/draft ports (ADR-0002)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "node -e \"import('node:fs').then((fs) => fs.rmSync('dist', { recursive: true, force: true }))\"",
    "export:catalogue-seed": "tsc -b tsconfig.build.json && node scripts/export-catalogue-seed.mjs"
  },
  "dependencies": {
    "@xr/contracts": "workspace:*",
    "@xr/domain": "workspace:*",
    "@xr/validation": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "@xr/config": "workspace:*",
    "@xr/testing": "workspace:*",
    "eslint": "9.39.5",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
