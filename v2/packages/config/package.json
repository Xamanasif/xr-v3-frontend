{
  "name": "@xr/config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared tooling presets (tsconfig, ESLint) and environment schemas for the V2 workspace",
  "type": "module",
  "exports": {
    "./tsconfig/*": "./tsconfig/*",
    "./eslint": "./eslint/base.mjs",
    "./env": {
      "types": "./dist/env/index.d.ts",
      "default": "./dist/env/index.js"
    },
    "./env/build": {
      "types": "./dist/env/build.d.ts",
      "default": "./dist/env/build.js"
    },
    "./package.json": "./package.json",
    "./eslint/boundaries": "./eslint/boundaries.mjs",
    "./eslint/boundary-matrix": "./eslint/boundary-matrix.mjs",
    "./policy-terms": "./policy/terms.mjs",
    "./eslint/fences": "./eslint/fences.mjs",
    "./eslint/rules": "./eslint/rules/index.mjs"
  },
  "files": [
    "dist",
    "eslint",
    "policy",
    "tsconfig"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:scans": "vitest run --config vitest.scans.config.ts",
    "clean": "node -e \"import('node:fs').then((fs) => fs.rmSync('dist', { recursive: true, force: true }))\""
  },
  "dependencies": {
    "@eslint/js": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "typescript-eslint": "8.70.0",
    "zod": "4.6.0"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "eslint": "9.39.5",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
