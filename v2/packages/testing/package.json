{
  "name": "@xr/testing",
  "version": "0.0.0",
  "private": true,
  "description": "Test foundations: Vitest configuration factory and Playwright base configuration",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./playwright": {
      "types": "./dist/playwright.d.ts",
      "default": "./dist/playwright.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "node -e \"import('node:fs').then((fs) => fs.rmSync('dist', { recursive: true, force: true }))\""
  },
  "dependencies": {
    "@playwright/test": "1.63.0",
    "@vitest/coverage-v8": "4.1.11",
    "vitest": "4.1.11"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "@xr/config": "workspace:*",
    "eslint": "9.39.5",
    "typescript": "6.0.3"
  }
}
