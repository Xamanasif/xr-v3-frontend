# XR Simulation Learning Platform — V2 environment
# Copy to `.env` (this directory). PLACEHOLDERS ONLY — never commit real secrets.
# Every variable is validated at boot by the Zod schema in packages/config/src/env.

# ---- Environment concept -------------------------------------------------
# development | staging | production
APP_ENV=development
NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ---- Platform API (apps/api) ---------------------------------------------
API_HOST=0.0.0.0
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
# Comma-separated browser origins allowed to call the API.
# Empty in development allows http://localhost:3000 and http://127.0.0.1:3000 only.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---- PostgreSQL (packages/database, Prisma) ------------------------------
# Matches docker-compose.yml. Leave EMPTY to run the API without a database;
# the health endpoint then reports the database check as "skipped".
DATABASE_URL=postgresql://xr:xr_dev_password@localhost:5432/xr_platform
# Host port docker-compose.yml publishes PostgreSQL on (default 5432). If 5432 is
# taken on this machine, set e.g. 55432 here AND in DATABASE_URL above.
# XR_POSTGRES_PORT=5432

# ---- Identity (OIDC / OAuth 2.0) — architecture placeholders --------------
# No identity provider is selected (docs/OPEN_DECISIONS.md A-01). Unused in Phase 0.
OIDC_ISSUER_URL=
OIDC_AUDIENCE=

# ---- Object storage (S3-compatible) — architecture placeholders -----------
# No vendor is selected (docs/OPEN_DECISIONS.md A-02 / E-07). Unused in Phase 0.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
