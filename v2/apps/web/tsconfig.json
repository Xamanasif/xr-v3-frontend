{
  "extends": "@xr/config/tsconfig/next-app.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "vitest.config.mts"
  ],
  "exclude": ["node_modules", ".next", "dist", "playwright-report", "test-results"]
}
