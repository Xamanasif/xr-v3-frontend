{
  "extends": "@xr/config/tsconfig/next-app.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "vitest.config.mts",
    ".next-test-hooks/types/**/*.ts",
    ".next-test-hooks/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    ".next-test-hooks",
    "dist",
    "playwright-report",
    "test-results"
  ]
}
