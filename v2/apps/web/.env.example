# Browser-visible configuration, inlined by Next.js at BUILD time. Copy to .env.local.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
# development (a local build) | prototype (the isolated prototype profile, DP-16) | staging | production.
# development and prototype run the sample stand-ins (browser-kept world, Reset, the simulated payment
# provider); staging and production never do.
NEXT_PUBLIC_APP_ENV=development
# Server-only, read at `next build` and `next start`. Any sample build other than development (whose
# sample accounts open with any password, TE-8) is refused unless the operator confirms the deployment
# is behind access protection (DP-17): set to 1 only then. Never set it for a public deployment.
# XR_SAMPLE_ACCESS_PROTECTED=1
# Where the service ports come from: sample (the in-browser sample world, default) or api (the
# future HTTP adapter — not built yet, so a build for it is refused). ADR-0007 TE-7.
NEXT_PUBLIC_XR_DATA_SOURCE=sample
