{
  "name": "@xr/api",
  "version": "0.0.0",
  "private": true,
  "description": "XR Simulation Learning Platform \u2014 platform API (NestJS on Fastify). The single authority for business rules and authorization.",
  "type": "module",
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "dev": "node scripts/dev.mjs",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "node -e \"import('node:fs').then((fs) => fs.rmSync('dist', { recursive: true, force: true }))\""
  },
  "dependencies": {
    "@fastify/static": "10.1.3",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-fastify": "12.0.1",
    "@nestjs/swagger": "12.0.1",
    "@xr/config": "workspace:*",
    "@xr/contracts": "workspace:*",
    "@xr/database": "workspace:*",
    "@xr/domain": "workspace:*",
    "@xr/validation": "workspace:*",
    "fastify": "5.12.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.0"
  },
  "devDependencies": {
    "@swc/core": "1.16.2",
    "@types/node": "24.13.4",
    "@xr/testing": "workspace:*",
    "eslint": "9.39.5",
    "typescript": "6.0.3",
    "unplugin-swc": "1.6.0",
    "vitest": "4.1.11"
  }
}
