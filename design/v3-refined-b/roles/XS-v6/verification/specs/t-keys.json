 {
  "name": "K7 reduced motion",
  "file": "fx-k-meera.dc.html",
  "width": 1440,
  "height": 900,
  "settle": 1400,
  "checks": false,
  "reducedMotion": true,
  "steps": [
   {
    "click": "#xs-acct-btn",
    "wait": 300
   },
   {
    "eval": "(() => { const m = document.querySelector('.xs-menu'); const s = getComputedStyle(m); return 'menu animation: ' + s.animationName + ' ' + s.animationDuration; })()",
    "label": "menu"
   },
   {
    "eval": "getComputedStyle(document.querySelector('.rb-rail')).position",
    "label": "rail position"
   }
  ]
 }
