 {
  "name": "K3 skip link + account menu keys",
  "file": "fx-k-meera.dc.html",
  "width": 1440,
  "height": 900,
  "settle": 1400,
  "checks": false,
  "steps": [
   {
    "press": "Tab",
    "focus": true,
    "label": "first tab"
   },
   {
    "eval": "getComputedStyle(document.querySelector('.xs-skip')).transform",
    "label": "skip transform when focused"
   },
   {
    "press": "Enter",
    "wait": 300,
    "focus": true,
    "label": "after skip"
   },
   {
    "eval": "(() => { const b = document.getElementById('xs-acct-btn'); b.focus(); return document.activeElement === b; })()",
    "label": "focus account button"
   },
   {
    "press": "Enter",
    "wait": 300,
    "focus": true,
    "label": "Enter opens -> first item"
   },
   {
    "press": "ArrowUp",
    "focus": true,
    "label": "ArrowUp wraps to last"
   },
   {
    "press": "Home",
    "focus": true,
    "label": "Home"
   },
   {
    "press": "End",
    "focus": true,
    "label": "End"
   },
   {
    "press": "Escape",
    "focus": true,
    "label": "Escape -> button"
   },
   {
    "attr": [
     "#xs-acct-btn",
     "aria-expanded"
    ],
    "label": "expanded"
   },
   {
    "press": "ArrowDown",
    "wait": 300,
    "focus": true,
    "label": "ArrowDown on closed button opens"
   },
   {
    "press": "Tab",
    "focus": true,
    "label": "Tab"
   },
   {
    "press": "Tab",
    "focus": true,
    "label": "Tab out of menu"
   },
   {
    "attr": [
     "#xs-acct-btn",
     "aria-expanded"
    ],
    "label": "expanded after tabbing out"
   },
   {
    "eval": "(() => { const b = document.getElementById('xs-acct-btn'); b.focus(); return 'ok'; })()"
   },
   {
    "press": "Space",
    "wait": 300,
    "focus": true,
    "label": "Space opens"
   },
   {
    "press": "ArrowDown",
    "focus": true,
    "label": "ArrowDown -> Sign out"
   },
   {
    "press": "Enter",
    "wait": 600,
    "focus": true,
    "label": "Enter on Sign out -> signed out"
   }
  ]
 },
