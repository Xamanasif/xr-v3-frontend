 {
  "name": "K3b menu tab-out and click inside",
  "file": "fx-k-meera.dc.html",
  "width": 1440,
  "height": 900,
  "settle": 1400,
  "checks": false,
  "steps": [
   {
    "eval": "(() => { document.getElementById('xs-acct-btn').focus(); return 'ok'; })()"
   },
   {
    "press": "Enter",
    "wait": 300,
    "focus": true,
    "label": "open"
   },
   {
    "press": "Tab",
    "focus": true,
    "label": "Tab"
   },
   {
    "press": "Tab",
    "focus": true,
    "label": "Tab out of menu"
   },
   {
    "attr": [
     "#xs-acct-btn",
     "aria-expanded"
    ],
    "label": "expanded after tabbing out"
   },
   {
    "click": "#xs-acct-btn",
    "wait": 300
   },
   {
    "click": ".xs-menu-name",
    "wait": 250,
    "attr": [
     "#xs-acct-btn",
     "aria-expanded"
    ],
    "label": "expanded after clicking the name in the panel"
   },
   {
    "mouse": [
     600,
     600
    ],
    "wait": 250,
    "attr": [
     "#xs-acct-btn",
     "aria-expanded"
    ],
    "label": "expanded after outside click"
   },
   {
    "focus": true,
    "label": "focus after outside click"
   }
  ]
 },
