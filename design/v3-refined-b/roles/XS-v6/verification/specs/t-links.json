 {
  "name": "L10 Send pressed twice creates one report",
  "file": "XS07-Help-InstituteAdmin-1440.dc.html",
  "width": 1440,
  "height": 900,
  "settle": 1500,
  "checks": false,
  "steps": [
   {
    "count": ".xs-report",
    "label": "rows before"
   },
   {
    "role": "link",
    "name": "Report a problem",
    "exact": true,
    "wait": 400
   },
   {
    "fill": [
     "#xs-help-what",
     "Pressed Send twice."
    ]
   },
   {
    "eval": "(() => { document.getElementById('xs-help-send').focus(); return document.activeElement.id; })()",
    "label": "focus"
   },
   {
    "press": "Enter",
    "wait": 60
   },
   {
    "eval": "document.getElementById('xs-help-send').getAttribute('aria-disabled') + ' / ' + document.getElementById('xs-help-send').innerText.trim()",
    "label": "busy after first Enter"
   },
   {
    "press": "Enter",
    "wait": 1400,
    "focus": true,
    "label": "after second Enter"
   },
   {
    "role": "link",
    "name": "View my reports",
    "exact": true,
    "wait": 500
   },
   {
    "count": ".xs-report",
    "label": "rows after (expect before + 1)"
   }
  ]
 },
 {
  "name": "L10b Sign in pressed twice",
