 {
  "name": "J8d-r1-marking-total-768",
  "file": "fa/T-j-nov07.dc.html",
  "width": 768,
  "steps": [
   {
    "click": "#fa-main a:has-text(\"Mark now\")",
    "expect": [
     "Marked automatically",
     "4 of 6 marks",
     "Question 4 of 4 · Written answer",
     "— of 16",
     "4 marked automatically + the written mark · pass mark 8",
     "Saving keeps your mark editable.",
     "Confirmed marks can’t be changed."
    ],
    "label": "marking page: auto marks in the sheet, total waits for the written mark"
   },
   {
    "fill": "#fa-mk-Q-0106",
    "value": "7",
    "expect": [
     "11 of 16",
     "4 marked automatically + 7 written · pass mark 8"
    ],
    "label": "total updates from the entered mark"
   },
   {
    "fill": "#fa-mk-Q-0106",
    "value": "12",
    "expect": "— of 16",
    "label": "an invalid mark gives no total"
   },
   {
    "fill": "#fa-mk-Q-0106",
    "value": "7"
   },
   {
    "click": "role=button[name=\"Save mark\"]",
    "expect": "Mark saved — not confirmed yet",
    "expectNot": "Saving keeps your mark editable.",
    "expectFocus": "fa-mk-saved",
    "label": "saved note replaces the save hint"
   },
   {
    "assert": "document.activeElement && document.getElementById('fa-mk-confirm').classList.contains('rb-btn--primary') && document.querySelectorAll('#fa-main .rb-btn--primary').length === 1",
    "label": "Confirm marks is the one primary"
   },
   {
    "noOverflow": true,
    "label": "no horizontal scroll"
   }
  ]
 },
