[
 {
  "name": "J8a-r1-overview-and-courses-768",
  "file": "fa/T-j-nov07.dc.html",
  "width": 768,
  "steps": [
   {
    "expect": [
     "Needs your attention",
     "Oldest waiting 2 days",
     "Rahul Verma",
     "5 Nov, 18:52",
     "Priya Natarajan",
     "6 Nov, 20:10",
     "Since 4 Nov",
     "Karthik Rao",
     "No activity since access, 12 Oct",
     "Imran Shaikh",
     "Last active 19 Oct"
    ],
    "label": "band: marking, drafts and follow-up, with the real names and dates"
   },
   {
    "assert": "document.querySelectorAll('#fa-main .rb-btn--primary').length === 1",
    "label": "one gold primary on the overview"
   },
   {
    "assert": "[...document.querySelectorAll('#fa-main a')].filter(a => /Mark/.test(a.textContent) && /Mark/.test(a.textContent.trim().slice(0,4))).length === 1",
    "label": "marking is offered once (no duplicate head button)"
   },
   {
    "expect": [
     "Coming up",
     "Due 14 Nov 2026, 23:59",
     "7 days left",
     "2 of 5 students submitted",
     "Students see results after the deadline"
    ],
    "label": "coming up: deadline, submissions, release rule"
   },
   {
    "expect": [
     "Your teaching",
     "2 completed",
     "2 in progress",
     "1 not started",
     "Assessment ready"
    ],
    "expectNot": "%",
    "label": "per-format progress in counts, no percentage"
   },
   {
    "click": "#fa-main a:has-text(\"Review drafts\")",
    "expect": [
     "Drafts to review",
     "3 drafts to review"
    ],
    "expectFocus": "fa-h1",
    "label": "Review drafts opens the drafts tab"
   },
   {
    "click": "#fa-menu"
   },
   {
    "click": ".rb-drawer a:has-text(\"Overview\")",
    "expect": "Needs your attention"
   },
   {
    "click": "#fa-main .fa-upi-t a",
    "expect": [
     "Ready to use",
     "Heat Exchanger — post-lab"
    ],
    "expectFocus": "fa-h1",
    "label": "coming-up title opens the assessment"
   },
   {
    "click": "#fa-menu"
   },
   {
    "click": ".rb-drawer a:has-text(\"Overview\")"
   },
   {
    "click": "#fa-main .fa-tc-h a:has-text(\"Open course\")",
    "expect": [
     "Course you teach",
     "Thermodynamics & Heat Transfer",
     "Student activity, by format",
     "2 of 5 students submitted",
     "2 written answers waiting for marking"
    ],
    "expectFocus": "fa-h1",
    "label": "Open course from Your teaching"
   },
   {
    "assert": "document.querySelectorAll('#fa-main .rb-btn--primary').length === 1 && !!document.querySelector('#fa-main .fa-xp-head .rb-btn')",
    "label": "course page: one primary (Mark), Open experiment is secondary"
   },
   {
    "click": "#fa-main .fa-xp-acts a:has-text(\"Mark 2 written answers\")",
    "expect": [
     "Rahul Verma",
     "Waiting for marking",
     "1 of 2 waiting · oldest first"
    ],
    "expectFocus": "fa-h1",
    "label": "Mark from the course opens the oldest submission"
   },
   {
    "click": "#fa-menu"
   },
   {
    "click": ".rb-drawer a:has-text(\"My courses\")",
    "expect": [
     "1 course · 1 experiment",
     "Experiments",
     "Students with access",
     "Assessments",
     "5 with access",
     "Due 14 Nov 2026, 23:59",
     "2 written answers waiting for marking"
    ],
    "label": "My courses ledger"
   },
   {
    "click": "#fa-main .fa-xrow a:has-text(\"Shell-and-Tube Heat Exchanger\")",
    "expect": [
     "About this experiment",
     "Learning outcomes"
    ],
    "expectFocus": "fa-h1",
    "label": "experiment link from the ledger"
   },
   {
    "click": "#fa-main .rk-crumbs a:has-text(\"ME ZG523\")",
    "expect": "Course you teach",
    "label": "breadcrumb back to the course"
   },
   {
    "click": "#fa-main a:has-text(\"Students on this experiment\")",
    "expect": [
     "Students",
     "Rahul Verma",
     "Karthik Rao"
    ],
    "expectFocus": "fa-h1",
    "label": "students on this experiment"
   },
   {
    "click": "#fa-menu"
   },
   {
    "click": ".rb-drawer a:has-text(\"My courses\")"
   },
   {
    "click": "#fa-main .fa-course-act a:has-text(\"Open course\")",
    "expect": "Course you teach",
    "expectFocus": "fa-h1"
   },
   {
    "click": "#fa-main .fa-xp-head a:has-text(\"Open experiment\")",
    "expect": "About this experiment",
    "expectFocus": "fa-h1",
    "label": "Open experiment from the course"
   },
   {
    "noOverflow": true,
    "label": "no horizontal scroll"
   }
  ]
 },
