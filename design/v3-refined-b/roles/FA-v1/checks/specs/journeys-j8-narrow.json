 {
  "name": "J8e-r1-drafting-form-768",
  "file": "fa/T-j-dr.dc.html",
  "width": 768,
  "steps": [
   {
    "click": "#fa-main .rk-head-act a:has-text(\"Draft with assistance\")",
    "expect": [
     "Material to draft from",
     "Question types",
     "How many drafts",
     "How drafting works",
     "Your bank for this experiment"
    ],
    "label": "authoring layout with the side panel"
   },
   {
    "assert": "document.querySelectorAll('.fa-nstep.is-done').length === 0 && !document.getElementById('fa-dr-n').checked && !document.getElementById('fa-dr-n5').checked",
    "label": "nothing pre-selected"
   },
   {
    "click": "#fa-dr-src-brief",
    "assert": "document.querySelectorAll('.fa-nstep.is-done').length === 1",
    "label": "step 1 done"
   },
   {
    "click": "#fa-dr-t-tf",
    "assert": "document.querySelectorAll('.fa-nstep.is-done').length === 2",
    "label": "step 2 done"
   },
   {
    "click": "#fa-dr-n5",
    "assert": "document.getElementById('fa-dr-n5').checked && document.querySelectorAll('.fa-nstep.is-done').length === 3",
    "label": "5 drafts chosen; step 3 done"
   },
   {
    "focus": "#fa-dr-n5",
    "press": "ArrowLeft",
    "assert": "document.getElementById('fa-dr-n').checked",
    "label": "arrow keys move within the radio group"
   },
   {
    "click": "role=button[name=\"Draft questions\"]",
    "wait": 1600,
    "expect": [
     "Drafts to review",
     "3 drafts left to review",
     "This request",
     "Correct answer"
    ],
    "expectFocus": "fa-dr-lh",
    "label": "three true-or-false drafts with their answers"
   },
   {
    "click": "[aria-label^=\"Add to bank: When one fluid condenses\"]",
    "expect": [
     "Added to your question bank.",
     "In your bank · reviewed by you",
     "True or false · 2 marks"
    ],
    "assert": "document.querySelectorAll('.fa-dcard.is-added').length === 1",
    "label": "an added draft collapses into a bank line"
   },
   {
    "expect": [
     "Drafted",
     "Left to review",
     "Added to your bank",
     "Discarded"
    ],
    "assert": "document.querySelector('.fa-side').innerText.indexOf('Added to your bank\\n1') >= 0",
    "label": "request summary counts"
   },
   {
    "noOverflow": true,
    "label": "no horizontal scroll"
   }
  ]
 },
