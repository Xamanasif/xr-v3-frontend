 {
  "name": "J8b-r1-course-without-assessment-768",
  "file": "fa/T-j-oct26.dc.html",
  "width": 768,
  "steps": [
   {
    "expect": [
     "Needs your attention",
     "Students to follow up",
     "Divya Menon",
     "Karthik Rao"
    ],
    "expectNot": [
     "Written answers to mark",
     "Drafts to review"
    ],
    "label": "one item: the band uses the single-item layout"
   },
   {
    "assert": "!!document.querySelector('.fa-prio--1')",
    "label": "single-item band"
   },
   {
    "expect": "No deadlines yet. They appear here once you create an assessment.",
    "label": "coming up is empty and says why"
   },
   {
    "click": "#fa-main .fa-tc-h a:has-text(\"Open course\")",
    "expect": [
     "No assessment yet",
     "No assessment for this experiment yet. Assessments are set per experiment, not per format."
    ],
    "label": "course without an assessment"
   },
   {
    "click": "#fa-main .fa-xp-acts a:has-text(\"Create assessment\")",
    "expect": [
     "Step 1 of 4",
     "Choose the experiment"
    ],
    "assert": "document.getElementById('fa-cw-e-ste').checked === true",
    "label": "Create assessment from the course keeps the experiment"
   },
   {
    "noOverflow": true,
    "label": "no horizontal scroll"
   }
  ]
 },
